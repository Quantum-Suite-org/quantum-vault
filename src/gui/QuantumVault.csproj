<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>QuantumVault</AssemblyName>
    <RootNamespace>QuantumVault</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <Product>Quantum Vault</Product>
    <Copyright>Quantum Vault - see LICENSE</Copyright>
    <ApplicationIcon Condition="Exists('Assets\icon.ico')">Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="4.11.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\quantum-suite-logo.jpg" />
    <Resource Include="Assets\icon.ico" Condition="Exists('Assets\icon.ico')" />
    <None Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\bin\qvault_core.dll" Link="qvault_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>



