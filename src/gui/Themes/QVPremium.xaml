<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette (reference: navy base, cyan accent, purple secondary) -->
  <SolidColorBrush x:Key="QV.Brush.BgBase"        Color="#070B14"/>
  <SolidColorBrush x:Key="QV.Brush.BgSurface"     Color="#0C1220"/>
  <SolidColorBrush x:Key="QV.Brush.BgCard"        Color="#111A2B"/>
  <SolidColorBrush x:Key="QV.Brush.BgCardHover"   Color="#16223A"/>
  <SolidColorBrush x:Key="QV.Brush.BgElevated"    Color="#1A2740"/>
  <SolidColorBrush x:Key="QV.Brush.BgInput"       Color="#0A1020"/>
  <SolidColorBrush x:Key="QV.Brush.BorderSubtle"  Color="#1B2A44"/>
  <SolidColorBrush x:Key="QV.Brush.BorderCard"    Color="#1F3358"/>
  <SolidColorBrush x:Key="QV.Brush.TextPrimary"   Color="#F1F5FF"/>
  <SolidColorBrush x:Key="QV.Brush.TextSecondary" Color="#9AA8C7"/>
  <SolidColorBrush x:Key="QV.Brush.TextMuted"     Color="#5C6B8A"/>
  <SolidColorBrush x:Key="QV.Brush.Cyan"          Color="#00C8E0"/>
  <SolidColorBrush x:Key="QV.Brush.CyanMuted"     Color="#2600C8E0"/>
  <SolidColorBrush x:Key="QV.Brush.PurpleBright"  Color="#A78BFA"/>
  <SolidColorBrush x:Key="QV.Brush.PurpleMuted"   Color="#2EA78BFA"/>
  <SolidColorBrush x:Key="QV.Brush.Green"         Color="#10B981"/>
  <SolidColorBrush x:Key="QV.Brush.Warning"       Color="#F59E0B"/>
  <SolidColorBrush x:Key="QV.Brush.Danger"        Color="#EF4444"/>
  <SolidColorBrush x:Key="QV.Brush.SidebarHover"  Color="#14203A"/>
  <SolidColorBrush x:Key="QV.Brush.SidebarActive" Color="#1A3150"/>

  <LinearGradientBrush x:Key="QV.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00C8E0" Offset="0"/>
    <GradientStop Color="#2563EB" Offset="0.55"/>
    <GradientStop Color="#7C3AED" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="QV.Font.UI">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="QV.Font.Mono">Cascadia Code, Consolas, Courier New</FontFamily>

  <!-- Primary: gradient, rounded -->
  <Style x:Key="QV.Style.ButtonPrimary" TargetType="Button">
    <Setter Property="Foreground" Value="#06101C"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  Background="{StaticResource QV.Brush.AccentGradient}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ghost: outlined, rounded -->
  <Style x:Key="QV.Style.ButtonGhost" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderBrush="{StaticResource QV.Brush.BorderCard}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource QV.Brush.BgCardHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Danger: soft red -->
  <Style x:Key="QV.Style.ButtonDanger" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource QV.Brush.Danger}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#40EF4444"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text input: rounded, cyan focus ring -->
  <Style x:Key="QV.Style.TextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource QV.Brush.BgInput}"/>
    <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{StaticResource QV.Brush.Cyan}"/>
    <Setter Property="BorderBrush" Value="{StaticResource QV.Brush.BorderCard}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                          Padding="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource QV.Brush.Cyan}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- List rows: rounded, hover + selected highlight -->
  <Style x:Key="QV.Style.ListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextPrimary}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource QV.Brush.BgCardHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource QV.Brush.SidebarActive}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QV.Style.Toggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
