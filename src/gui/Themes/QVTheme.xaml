<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         QUANTUM VAULT — Master Theme
         Matches reference: dark navy base, cyan accent, purple glow
    ═══════════════════════════════════════════════════════════ -->

    <!-- Base Surfaces -->
    <Color x:Key="QV.BgDeep">#080C14</Color>
    <Color x:Key="QV.BgBase">#0D1117</Color>
    <Color x:Key="QV.BgSurface">#111827</Color>
    <Color x:Key="QV.BgCard">#1A2332</Color>
    <Color x:Key="QV.BgCardHover">#1E2A3E</Color>
    <Color x:Key="QV.BgElevated">#1F2D42</Color>
    <Color x:Key="QV.BgInput">#0F1822</Color>
    <Color x:Key="QV.BgSelected">#0D2040</Color>
    <Color x:Key="QV.BgModal">#131C2A</Color>

    <!-- Sidebar -->
    <Color x:Key="QV.SidebarBg">#090D16</Color>
    <Color x:Key="QV.SidebarStrip">#060A12</Color>
    <Color x:Key="QV.SidebarActive">#0D2040</Color>
    <Color x:Key="QV.SidebarHover">#111D30</Color>

    <!-- Cyan — Primary Accent -->
    <Color x:Key="QV.Cyan">#00C8E0</Color>
    <Color x:Key="QV.CyanBright">#00E5FF</Color>
    <Color x:Key="QV.CyanDim">#007A8C</Color>
    <Color x:Key="QV.CyanMuted">#002830</Color>
    <Color x:Key="QV.CyanGlow">#1A4A52</Color>

    <!-- Purple — Secondary Accent -->
    <Color x:Key="QV.Purple">#7C3AED</Color>
    <Color x:Key="QV.PurpleBright">#A78BFA</Color>
    <Color x:Key="QV.PurpleDim">#4C1D95</Color>
    <Color x:Key="QV.PurpleMuted">#1E1040</Color>

    <!-- Green — Success / Secure -->
    <Color x:Key="QV.Green">#10B981</Color>
    <Color x:Key="QV.GreenBright">#34D399</Color>
    <Color x:Key="QV.GreenMuted">#064E3B</Color>

    <!-- Semantic -->
    <Color x:Key="QV.Warning">#F59E0B</Color>
    <Color x:Key="QV.Danger">#EF4444</Color>
    <Color x:Key="QV.Info">#3B82F6</Color>

    <!-- Borders -->
    <Color x:Key="QV.BorderSubtle">#1E3A5F</Color>
    <Color x:Key="QV.BorderMed">#1E4976</Color>
    <Color x:Key="QV.BorderFocus">#00C8E0</Color>
    <Color x:Key="QV.BorderCard">#1E3558</Color>

    <!-- Text -->
    <Color x:Key="QV.TextPrimary">#F1F5F9</Color>
    <Color x:Key="QV.TextSecondary">#94A3B8</Color>
    <Color x:Key="QV.TextMuted">#475569</Color>
    <Color x:Key="QV.TextDisabled">#2D3D55</Color>
    <Color x:Key="QV.TextCyan">#00C8E0</Color>
    <Color x:Key="QV.TextPurple">#A78BFA</Color>

    <!-- ═══ Brushes ═══ -->
    <SolidColorBrush x:Key="QV.Brush.BgDeep"       Color="{StaticResource QV.BgDeep}"/>
    <SolidColorBrush x:Key="QV.Brush.BgBase"        Color="{StaticResource QV.BgBase}"/>
    <SolidColorBrush x:Key="QV.Brush.BgSurface"     Color="{StaticResource QV.BgSurface}"/>
    <SolidColorBrush x:Key="QV.Brush.BgCard"        Color="{StaticResource QV.BgCard}"/>
    <SolidColorBrush x:Key="QV.Brush.BgCardHover"   Color="{StaticResource QV.BgCardHover}"/>
    <SolidColorBrush x:Key="QV.Brush.BgElevated"    Color="{StaticResource QV.BgElevated}"/>
    <SolidColorBrush x:Key="QV.Brush.BgInput"       Color="{StaticResource QV.BgInput}"/>
    <SolidColorBrush x:Key="QV.Brush.BgSelected"    Color="{StaticResource QV.BgSelected}"/>
    <SolidColorBrush x:Key="QV.Brush.BgModal"       Color="{StaticResource QV.BgModal}"/>
    <SolidColorBrush x:Key="QV.Brush.SidebarBg"     Color="{StaticResource QV.SidebarBg}"/>
    <SolidColorBrush x:Key="QV.Brush.SidebarStrip"  Color="{StaticResource QV.SidebarStrip}"/>
    <SolidColorBrush x:Key="QV.Brush.SidebarActive" Color="{StaticResource QV.SidebarActive}"/>
    <SolidColorBrush x:Key="QV.Brush.SidebarHover"  Color="{StaticResource QV.SidebarHover}"/>
    <SolidColorBrush x:Key="QV.Brush.Cyan"          Color="{StaticResource QV.Cyan}"/>
    <SolidColorBrush x:Key="QV.Brush.CyanBright"    Color="{StaticResource QV.CyanBright}"/>
    <SolidColorBrush x:Key="QV.Brush.CyanDim"       Color="{StaticResource QV.CyanDim}"/>
    <SolidColorBrush x:Key="QV.Brush.CyanMuted"     Color="{StaticResource QV.CyanMuted}"/>
    <SolidColorBrush x:Key="QV.Brush.CyanGlow"      Color="{StaticResource QV.CyanGlow}"/>
    <SolidColorBrush x:Key="QV.Brush.Purple"        Color="{StaticResource QV.Purple}"/>
    <SolidColorBrush x:Key="QV.Brush.PurpleBright"  Color="{StaticResource QV.PurpleBright}"/>
    <SolidColorBrush x:Key="QV.Brush.PurpleDim"     Color="{StaticResource QV.PurpleDim}"/>
    <SolidColorBrush x:Key="QV.Brush.PurpleMuted"   Color="{StaticResource QV.PurpleMuted}"/>
    <SolidColorBrush x:Key="QV.Brush.Green"         Color="{StaticResource QV.Green}"/>
    <SolidColorBrush x:Key="QV.Brush.GreenBright"   Color="{StaticResource QV.GreenBright}"/>
    <SolidColorBrush x:Key="QV.Brush.GreenMuted"    Color="{StaticResource QV.GreenMuted}"/>
    <SolidColorBrush x:Key="QV.Brush.Warning"       Color="{StaticResource QV.Warning}"/>
    <SolidColorBrush x:Key="QV.Brush.Danger"        Color="{StaticResource QV.Danger}"/>
    <SolidColorBrush x:Key="QV.Brush.BorderSubtle"  Color="{StaticResource QV.BorderSubtle}"/>
    <SolidColorBrush x:Key="QV.Brush.BorderMed"     Color="{StaticResource QV.BorderMed}"/>
    <SolidColorBrush x:Key="QV.Brush.BorderFocus"   Color="{StaticResource QV.BorderFocus}"/>
    <SolidColorBrush x:Key="QV.Brush.BorderCard"    Color="{StaticResource QV.BorderCard}"/>
    <SolidColorBrush x:Key="QV.Brush.TextPrimary"   Color="{StaticResource QV.TextPrimary}"/>
    <SolidColorBrush x:Key="QV.Brush.TextSecondary" Color="{StaticResource QV.TextSecondary}"/>
    <SolidColorBrush x:Key="QV.Brush.TextMuted"     Color="{StaticResource QV.TextMuted}"/>
    <SolidColorBrush x:Key="QV.Brush.TextDisabled"  Color="{StaticResource QV.TextDisabled}"/>
    <SolidColorBrush x:Key="QV.Brush.TextCyan"      Color="{StaticResource QV.TextCyan}"/>
    <SolidColorBrush x:Key="QV.Brush.TextPurple"    Color="{StaticResource QV.TextPurple}"/>

    <!-- Gradient brushes for glow effects -->
    <LinearGradientBrush x:Key="QV.Brush.CyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00C8E0" Offset="0"/>
        <GradientStop Color="#007A8C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QV.Brush.PurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QV.Brush.CardBorderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E4976" Offset="0"/>
        <GradientStop Color="#1E3A5F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QV.Brush.SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#090D16" Offset="0"/>
        <GradientStop Color="#060A12" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ Override MahApps accent to match QV theme ═══ -->
    <SolidColorBrush x:Key="MahApps.Brushes.Accent"          Color="#00C8E0"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent2"         Color="#007A8C"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent3"         Color="#005060"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent4"         Color="#002830"/>
    <SolidColorBrush x:Key="MahApps.Brushes.WindowBackground" Color="#0D1117"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground"  Color="#0D1117"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeForeground"  Color="#F1F5F9"/>

    <!-- ═══ Shared geometry ═══ -->
    <CornerRadius x:Key="QV.Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="QV.Radius.Button">6</CornerRadius>
    <CornerRadius x:Key="QV.Radius.Input">5</CornerRadius>
    <CornerRadius x:Key="QV.Radius.Badge">4</CornerRadius>
    <CornerRadius x:Key="QV.Radius.Tag">12</CornerRadius>

    <!-- ═══ Typography ═══ -->
    <FontFamily x:Key="QV.Font.UI">Segoe UI, Segoe UI Semibold, Arial</FontFamily>
    <FontFamily x:Key="QV.Font.Mono">Cascadia Code, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="QV.FontSize.XS">10</sys:Double>
    <sys:Double x:Key="QV.FontSize.SM">11</sys:Double>
    <sys:Double x:Key="QV.FontSize.MD">13</sys:Double>
    <sys:Double x:Key="QV.FontSize.LG">15</sys:Double>
    <sys:Double x:Key="QV.FontSize.XL">18</sys:Double>
    <sys:Double x:Key="QV.FontSize.2XL">24</sys:Double>
    <sys:Double x:Key="QV.FontSize.3XL">32</sys:Double>

    <!-- ═══ Card Style ═══ -->
    <Style x:Key="QV.Style.Card" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource QV.Brush.BgCard}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource QV.Brush.BorderCard}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="{StaticResource QV.Radius.Card}"/>
        <Setter Property="Padding"          Value="16"/>
    </Style>

    <!-- ═══ Primary Button ═══ -->
    <Style x:Key="QV.Style.ButtonPrimary" TargetType="Button">
        <Setter Property="Background"        Value="{StaticResource QV.Brush.Cyan}"/>
        <Setter Property="Foreground"        Value="#0D1117"/>
        <Setter Property="FontFamily"        Value="{StaticResource QV.Font.UI}"/>
        <Setter Property="FontSize"          Value="{StaticResource QV.FontSize.MD}"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="Padding"           Value="20,10"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.CyanBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.CyanDim}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Ghost Button ═══ -->
    <Style x:Key="QV.Style.ButtonGhost" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource QV.Brush.TextSecondary}"/>
        <Setter Property="FontFamily"       Value="{StaticResource QV.Font.UI}"/>
        <Setter Property="FontSize"         Value="{StaticResource QV.FontSize.MD}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="BorderBrush"      Value="{StaticResource QV.Brush.BorderSubtle}"/>
        <Setter Property="Padding"          Value="16,8"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.BgElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource QV.Brush.BorderMed}"/>
                            <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.BgCard}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Danger Button ═══ -->
    <Style x:Key="QV.Style.ButtonDanger" TargetType="Button" BasedOn="{StaticResource QV.Style.ButtonGhost}">
        <Setter Property="Foreground"  Value="{StaticResource QV.Brush.Danger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource QV.Brush.Danger}"/>
    </Style>

    <!-- ═══ Icon Button (no border) ═══ -->
    <Style x:Key="QV.Style.ButtonIcon" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Foreground"       Value="{StaticResource QV.Brush.TextMuted}"/>
        <Setter Property="Padding"          Value="6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.BgElevated}"/>
                            <Setter Property="Foreground" Value="{StaticResource QV.Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.BgCard}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ TextBox ═══ -->
    <Style x:Key="QV.Style.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily"        Value="{StaticResource QV.Font.UI}"/>
        <Setter Property="FontSize"          Value="{StaticResource QV.FontSize.MD}"/>
        <Setter Property="Foreground"        Value="{StaticResource QV.Brush.TextPrimary}"/>
        <Setter Property="Background"        Value="{StaticResource QV.Brush.BgInput}"/>
        <Setter Property="BorderBrush"       Value="{StaticResource QV.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="12,9"/>
        <Setter Property="CaretBrush"        Value="{StaticResource QV.Brush.Cyan}"/>
        <Setter Property="SelectionBrush"    Value="{StaticResource QV.Brush.CyanMuted}"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource QV.Brush.Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource QV.Brush.BorderMed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PasswordBox ═══ -->
    <Style x:Key="QV.Style.PasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily"        Value="{StaticResource QV.Font.UI}"/>
        <Setter Property="FontSize"          Value="{StaticResource QV.FontSize.MD}"/>
        <Setter Property="Foreground"        Value="{StaticResource QV.Brush.TextPrimary}"/>
        <Setter Property="Background"        Value="{StaticResource QV.Brush.BgInput}"/>
        <Setter Property="BorderBrush"       Value="{StaticResource QV.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="12,9"/>
        <Setter Property="CaretBrush"        Value="{StaticResource QV.Brush.Cyan}"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource QV.Brush.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ScrollViewer ═══ -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ═══ Slim ScrollBar ═══ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#1E4976" CornerRadius="2" Opacity="0.8"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ ListBox / ListBoxItem ═══ -->
    <Style x:Key="QV.Style.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="Foreground"        Value="{StaticResource QV.Brush.TextPrimary}"/>
        <Setter Property="Padding"           Value="0"/>
        <Setter Property="Margin"            Value="0,1"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.SidebarHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource QV.Brush.SidebarActive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Toggle / Switch style CheckBox ═══ -->
    <Style x:Key="QV.Style.Toggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Grid.Column="0"
                                Width="36" Height="20" CornerRadius="10"
                                Background="{StaticResource QV.Brush.BorderSubtle}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="14" Height="14"
                                     Fill="White" Margin="3,0,0,0"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource QV.Brush.Cyan}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Separator ═══ -->
    <Style TargetType="Separator">
        <Setter Property="Background"  Value="{StaticResource QV.Brush.BorderSubtle}"/>
        <Setter Property="Height"      Value="1"/>
        <Setter Property="Margin"      Value="0,4"/>
    </Style>

    <!-- ═══ ComboBox ═══ -->
    <Style x:Key="QV.Style.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily"       Value="{StaticResource QV.Font.UI}"/>
        <Setter Property="FontSize"         Value="{StaticResource QV.FontSize.MD}"/>
        <Setter Property="Foreground"       Value="{StaticResource QV.Brush.TextPrimary}"/>
        <Setter Property="Background"       Value="{StaticResource QV.Brush.BgInput}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource QV.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="10,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

</ResourceDictionary>

